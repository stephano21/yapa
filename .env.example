# Copia este archivo a .env y completa los valores ( .env no se sube a git ).
#
# Android SDK (opcional si ya tienes ANDROID_HOME en el sistema)
# Windows ejemplo: C:\\Users\\TU_USUARIO\\AppData\\Local\\Android\\Sdk
ANDROID_HOME=

# Firma release local / prebuild → android/local.properties (MYAPP_UPLOAD_*)
# Ruta absoluta al .keystore o .jks
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_ALIAS=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_PASSWORD=

# API Pulse: solo https://tu-dominio.com (sin /v1/health). Reinicia Expo tras cambiar .env.
EXPO_PUBLIC_PULSE_API_URL=
# Solo depuración (dev): al sincronizar, log del JWT en consola Metro. Valores: 1 / true / yes. Quitar después.
EXPO_PUBLIC_PULSE_DEBUG_SHOW_TOKEN=

# Google Sign-In nativo (@react-native-google-signin/google-signin). No Expo Go: usa dev build (expo run:android).
# OBLIGATORIO en móvil: cliente tipo "Aplicación web" (para id_token; suele coincidir con Authentication__Google__ClientId del API).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Mismo proyecto: cliente Android con package com.stynger.Yapa + SHA-1 debug y release (npm run android:signing-report).
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Opcional: un solo ID para varias plataformas (ver src/config/pulse.ts).
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
